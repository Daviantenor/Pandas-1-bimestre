Notas

from sklearn.linear_model import LinearRegression
# X(Atributos) - Valores que são usados para fazer a previsão
horas_estudo = [[1],[2],[3],[4],[5]]

#Y (Alvo - Target)-Valores que queremos prever

nota = [10,20,40,50,65]

modelo = LinearRegression()# Cria o modelo de Regressão Linear;
modelo.fit(horas_estudo, nota)# Treinando o modelo .fit(X,Y);

previsao = modelo.predict([[4]])

print(previsao)
